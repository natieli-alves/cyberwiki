generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Conceito {
  id        Int      @id @default(autoincrement())
  nome      String
  slug      String   @unique
  descricao String
  conteudo  String
  destaque  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}